{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "build/**"],
			"env": ["BITE_MENU_ACTION_HOSTS"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"outputs": ["coverage/**"],
			"env": ["TEST_DATABASE_URL", "CI"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
