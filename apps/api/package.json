	},
	"dependencies": {
		"@bite/contracts": "workspace:*",
		"@bite/core": "workspace:*",
		"@bite/db": "workspace:*",
		"@hono/node-server": "^2.1.9",
		"@hono/zod-validator": "^0.9.1",
		"@node-rs/argon2": "^2.2.2",
		"better-auth": "^1.7.25",
		"hono": "^4.13.19",
		"pg-boss": "^12.38.2",
		"postgres": "^4.1.1",
		"uuid": "^14.0.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^5.1.0"
	}
