{
	"extends": "../../tsconfig.base.json",
	"include": ["**/*", ".react-router/types/**/*"],
	"exclude": ["build", "node_modules"],
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2023"],
		"types": ["node", "vite/client"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"rootDirs": [".", "./.react-router/types"],
		"noEmit": true,
		"declaration": false
	}
}
